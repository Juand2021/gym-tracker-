# PIN de Juan (datos actuales en colecciones raíz de Firestore)
SITE_PIN=1234

# PIN de Laura (perfil aislado en users/laura/...)
SITE_PIN_LAURA=2026

# Azure OpenAI (recomendado para este proyecto)
AZURE_OPENAI_ENDPOINT=https://TU-RECURSO.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=tu-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini

# Alternativa: OpenAI estándar (si no usas Azure)
# OPENAI_API_KEY=sk-...

# Firebase Admin (JSON de service account en una sola línea, o path local)
# Opción A: pegar el JSON completo del service account
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Opción B (alternativa): variables sueltas
# FIREBASE_PROJECT_ID=tu-proyecto
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@....iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
