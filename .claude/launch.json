{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gym-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "-p",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "nutriverse-local",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/dev-local.mjs"],
      "port": 3100
    },
    {
      "name": "nutriverse-wifi",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:iphone"],
      "port": 3000
    },
    {
      "name": "nutriverse-iphone",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "iphone"],
      "port": 3000
    }
  ]
}